{
  "category": "export_platform",
  "decisions": [
    {"id": "export_platform.preset_tiktok", "category": "export_platform", "name": "TikTok preset", "detector": {"kind": "always"}, "effect": {"op": "export_setting", "args": {"preset_id": "tiktok_1080x1920_30", "safe_zone_preset": "tiktok"}}, "params": {}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip"], "source": "house", "rationale": "1080x1920, 30 fps, H.264 yuv420p, CRF 18 master."},
    {"id": "export_platform.preset_reels", "category": "export_platform", "name": "Reels preset", "detector": {"kind": "always"}, "effect": {"op": "export_setting", "args": {"preset_id": "reels_1080x1920_30", "safe_zone_preset": "reels"}}, "params": {}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip"], "source": "house", "rationale": "Reels up to 3 min are eligible for recommendation."},
    {"id": "export_platform.preset_shorts", "category": "export_platform", "name": "Shorts preset", "detector": {"kind": "always"}, "effect": {"op": "export_setting", "args": {"preset_id": "shorts_1080x1920_30", "safe_zone_preset": "shorts"}}, "params": {"fps": {"type": "enum", "default": 30, "values": [30, 60]}}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip"], "source": "house", "rationale": "Shorts up to 3 min; music rules differ over 60 s (rule A2)."},
    {"id": "export_platform.preset_youtube_16x9", "category": "export_platform", "name": "YouTube 16:9 preset", "detector": {"kind": "always"}, "effect": {"op": "export_setting", "args": {"preset_id": "yt_1920x1080", "safe_zone_preset": "none"}}, "params": {}, "applies_to": ["long_form"], "source": "house", "default_on": true, "rationale": "Long-form master."},
    {"id": "export_platform.safe_zone_strict", "category": "export_platform", "name": "Universal strict safe zone", "detector": {"kind": "always"}, "effect": {"op": "export_setting", "args": {"safe_zone_preset": "universal_strict"}}, "params": {}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip"], "conflicts_with": ["export_platform.preset_tiktok", "export_platform.preset_reels", "export_platform.preset_shorts"], "source": "house", "default_on": true, "rationale": "One render that is safe on all three vertical platforms; validate hard UI text against it, captions against universal_relaxed."},
    {"id": "export_platform.cover_frame_from_hook", "category": "export_platform", "name": "Cover frame from the hook", "detector": {"kind": "time_range", "args": {"start_ms": 0, "end_ms": 3000}}, "effect": {"op": "export_setting", "args": {"cover_from": "hook"}}, "params": {}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "cover_frame renders a still of the hook range at 1080x1920 and 1280x720."},
    {"id": "export_platform.sidecar_captions", "category": "export_platform", "name": "Sidecar SRT and VTT", "detector": {"kind": "always"}, "effect": {"op": "export_setting", "args": {"sidecar_captions": true}}, "params": {}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "Always ship SRT and VTT with the package even when captions are burned in."},
    {"id": "export_platform.loudness_normalize", "category": "export_platform", "name": "Loudness normalize on export", "detector": {"kind": "always"}, "effect": {"op": "export_setting", "args": {"loudnorm": {"I": -14, "TP": -1, "LRA": 11}}}, "params": {}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "Two-pass loudnorm; targets are conventions, not verified platform numbers."},
    {"id": "export_platform.multi_platform_variants", "category": "export_platform", "name": "One variant per platform", "detector": {"kind": "always"}, "effect": {"op": "export_setting", "args": {"variants_per_platform": true}}, "params": {}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip"], "source": "house", "rationale": "multi_platform_resize re-validates the safe zone per target."}
  ]
}
