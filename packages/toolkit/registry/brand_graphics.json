{
  "category": "brand_graphics",
  "decisions": [
    {"id": "brand_graphics.logo_bug", "category": "brand_graphics", "name": "Logo bug", "detector": {"kind": "always"}, "effect": {"op": "layer_add", "args": {"kind": "logo_bug", "slot": "pip", "primitive": "pop_in", "duration_ms": 600}}, "params": {"position": {"type": "enum", "default": "top_right", "values": ["top_left", "top_right", "bottom_left", "bottom_right"]}, "opacity": {"type": "number", "default": 0.7, "min": 0.3, "max": 1}}, "applies_to": ["talking_head", "ad_ugc", "screen_demo", "podcast_clip", "long_form", "faceless"], "source": "house", "rationale": "Safe-zone-aware corner from the brand kit. Never other apps' logos or watermarks (Instagram downranks visible third-party watermarks)."},
    {"id": "brand_graphics.lower_third_first_appearance", "category": "brand_graphics", "name": "Lower third at first appearance", "detector": {"kind": "face_present", "args": {"min_ms": 1500}}, "effect": {"op": "layer_add", "args": {"kind": "lower_third", "slot": "lower_third", "primitive": "slide", "duration_ms": 3500}}, "params": {"duration_ms": {"type": "integer", "default": 3500, "min": 2000, "max": 6000}}, "applies_to": ["talking_head", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "Name and title once per speaker; needs the speaker name from the brand kit or the user."},
    {"id": "brand_graphics.brand_colors_on_captions", "category": "brand_graphics", "name": "Brand colors on captions", "detector": {"kind": "always"}, "effect": {"op": "caption_style", "args": {"use_brand_colors": true}}, "params": {}, "applies_to": ["talking_head", "ad_ugc", "screen_demo", "podcast_clip", "long_form", "faceless"], "source": "house", "default_on": true, "rationale": "Emphasis color = brand accent; body stays white for contrast (L1)."},
    {"id": "brand_graphics.intro_card", "category": "brand_graphics", "name": "Intro card", "detector": {"kind": "time_range", "args": {"start_ms": 0, "end_ms": 0}}, "effect": {"op": "layer_add", "args": {"kind": "image", "slot": "full_bleed", "primitive": "crossfade", "duration_ms": 1200}}, "params": {"max_ms": {"type": "integer", "default": 1500, "min": 500, "max": 3000}}, "applies_to": ["long_form"], "source": "house", "rationale": "Intros eat hook time: off for short-form by default."},
    {"id": "brand_graphics.outro_end_card", "category": "brand_graphics", "name": "Outro and end card with CTA", "detector": {"kind": "always"}, "effect": {"op": "layer_add", "args": {"kind": "image", "slot": "full_bleed", "primitive": "slide", "duration_ms": 1500}}, "params": {"duration_ms": {"type": "integer", "default": 1500, "min": 800, "max": 4000}}, "applies_to": ["talking_head", "ad_ugc", "screen_demo", "podcast_clip", "long_form"], "source": "house", "rationale": "Handle, one CTA, brand colors; at most 1.5 s in short-form."},
    {"id": "brand_graphics.progress_bar", "category": "brand_graphics", "name": "Progress bar", "detector": {"kind": "always"}, "effect": {"op": "layer_add", "args": {"kind": "shape", "slot": "hud_top", "primitive": "bar_grow"}}, "params": {"height_px": {"type": "integer", "default": 6, "min": 2, "max": 14}}, "applies_to": ["faceless", "talking_head", "ad_ugc"], "source": "house", "rationale": "Signals the video is short; place inside the safe zone, not at the frame edge."}
  ]
}
