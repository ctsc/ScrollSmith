{
  "category": "color_look",
  "decisions": [
    {"id": "color_look.lut_apply", "category": "color_look", "name": "Apply a LUT", "detector": {"kind": "always"}, "effect": {"op": "color", "args": {"lut": "{{lut}}"}}, "params": {"lut": {"type": "string", "default": "none"}}, "applies_to": ["talking_head", "ad_ugc", "podcast_clip", "long_form"], "source": "house", "rationale": "FFmpeg lut3d with a user-supplied .cube; none by default."},
    {"id": "color_look.contrast_saturation_bump", "category": "color_look", "name": "Contrast and saturation bump", "detector": {"kind": "always"}, "effect": {"op": "color", "args": {}}, "params": {"contrast": {"type": "number", "default": 1.05, "min": 0.9, "max": 1.3}, "saturation": {"type": "number", "default": 1.1, "min": 0.8, "max": 1.4}}, "applies_to": ["talking_head", "ad_ugc", "podcast_clip", "long_form", "screen_demo"], "source": "house", "default_on": true, "rationale": "Small lift; phone screens already saturate."},
    {"id": "color_look.skin_tone_protect", "category": "color_look", "name": "Skin-tone protect", "detector": {"kind": "face_present"}, "effect": {"op": "color", "args": {"skin_protect": true}}, "params": {}, "applies_to": ["talking_head", "ad_ugc", "podcast_clip", "long_form"], "requires": ["color_look.contrast_saturation_bump"], "source": "house", "default_on": true, "rationale": "Saturation bumps drift skin orange; mask the skin hue range."},
    {"id": "color_look.vignette", "category": "color_look", "name": "Vignette", "detector": {"kind": "always"}, "effect": {"op": "color", "args": {}}, "params": {"vignette": {"type": "number", "default": 0.15, "min": 0, "max": 0.5}}, "applies_to": ["talking_head", "faceless", "ad_ugc"], "source": "house", "rationale": "Draws the eye to the center; subtle."},
    {"id": "color_look.grain", "category": "color_look", "name": "Film grain", "detector": {"kind": "always"}, "effect": {"op": "color", "args": {}}, "params": {"grain": {"type": "number", "default": 0.08, "min": 0, "max": 0.3}}, "applies_to": ["faceless", "talking_head", "ad_ugc"], "source": "house", "rationale": "Hides banding in gradients; costs bitrate."},
    {"id": "color_look.bw_for_emphasis", "category": "color_look", "name": "Black and white for emphasis", "detector": {"kind": "emphasis_word", "args": {"min_score": 2.5}}, "effect": {"op": "color", "args": {"saturation": 0}}, "params": {"duration_ms": {"type": "integer", "default": 800}}, "applies_to": ["talking_head", "ad_ugc"], "source": "house", "rationale": "One desaturated beat on the key line; more than once is a gimmick."}
  ]
}
