{
  "category": "zoom_framing",
  "decisions": [
    {"id": "zoom_framing.punch_on_emphasis_word", "category": "zoom_framing", "name": "Punch-in on emphasis words", "detector": {"kind": "emphasis_word", "args": {"min_score": "{{min_score}}"}}, "effect": {"op": "zoom", "args": {"easing": "spring_snappy"}}, "params": {"scale": {"type": "number", "default": 1.12, "min": 1.08, "max": 1.25}, "ms": {"type": "integer", "default": 400, "min": 200, "max": 900}, "max_per_min": {"type": "integer", "default": 10, "min": 2, "max": 30}, "min_score": {"type": "number", "default": 1.2}}, "applies_to": ["talking_head", "ad_ugc", "podcast_clip"], "source": "house", "default_on": true, "rationale": "A punch-in on the stressed word adds a visual change where the audio already has energy. Never in the first or last 300 ms of a shot; face stays inside the safe zone (F3)."},
    {"id": "zoom_framing.punch_on_sentence_start", "category": "zoom_framing", "name": "Alternate punch-in on sentence starts", "detector": {"kind": "sentence_boundary"}, "effect": {"op": "zoom", "args": {"easing": "ease_out_expo"}}, "params": {"scale": {"type": "number", "default": 1.08, "min": 1.04, "max": 1.15}, "ms": {"type": "integer", "default": 600}, "max_per_min": {"type": "integer", "default": 8}}, "applies_to": ["talking_head", "long_form"], "conflicts_with": ["zoom_framing.punch_on_emphasis_word"], "source": "house", "rationale": "Gentler pacing device for calm formats."},
    {"id": "zoom_framing.slow_push_long_shots", "category": "zoom_framing", "name": "Slow push on long shots", "detector": {"kind": "time_range"}, "effect": {"op": "zoom", "args": {"easing": "linear"}}, "params": {"scale": {"type": "number", "default": 1.05, "min": 1.02, "max": 1.1}, "ms": {"type": "integer", "default": 4000}, "max_per_min": {"type": "integer", "default": 6}}, "applies_to": ["talking_head", "podcast_clip", "long_form"], "source": "house", "rationale": "A barely perceptible push keeps a static shot alive."},
    {"id": "zoom_framing.alternate_crop_ab", "category": "zoom_framing", "name": "Alternate A/B crop on each cut", "detector": {"kind": "always"}, "effect": {"op": "crop_path", "args": {"mode": "alternate_ab"}}, "params": {"b_scale": {"type": "number", "default": 1.15, "min": 1.1, "max": 1.3}}, "applies_to": ["talking_head", "ad_ugc"], "source": "house", "rationale": "Two framings from one camera simulate a two-camera shoot and hide jump cuts."},
    {"id": "zoom_framing.auto_reframe_face_track", "category": "zoom_framing", "name": "Auto-reframe to vertical with subject tracking", "detector": {"kind": "face_present"}, "effect": {"op": "crop_path", "args": {"mode": "face_track"}}, "params": {"smoothing": {"type": "number", "default": 0.85, "min": 0.5, "max": 0.98}, "headroom": {"type": "number", "default": 0.12, "min": 0.05, "max": 0.25}}, "applies_to": ["talking_head", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "16:9 sources need a smoothed crop path that follows the speaker; two speakers use split-screen or cut-follow-speaker."},
    {"id": "zoom_framing.headroom_rule", "category": "zoom_framing", "name": "Headroom rule", "detector": {"kind": "face_present"}, "effect": {"op": "crop_path", "args": {"mode": "face_track"}}, "params": {"headroom": {"type": "number", "default": 0.12, "min": 0.05, "max": 0.25}}, "applies_to": ["talking_head"], "requires": ["zoom_framing.auto_reframe_face_track"], "source": "house", "rationale": "Eyes at about one third from the top; too much headroom reads amateur."},
    {"id": "zoom_framing.speaker_recenter", "category": "zoom_framing", "name": "Re-center on speaker change", "detector": {"kind": "face_present", "args": {"min_ms": 1500}}, "effect": {"op": "crop_path", "args": {"mode": "cut_follow_speaker"}}, "params": {}, "applies_to": ["podcast_clip", "long_form"], "source": "house", "rationale": "Follow the active speaker instead of a wide two-shot in vertical."}
  ]
}
