{
  "category": "music",
  "decisions": [
    {"id": "music.pick_by_mood_bpm", "category": "music", "name": "Pick track by mood and BPM", "detector": {"kind": "always"}, "effect": {"op": "music", "args": {"select": {"mood": "{{mood}}", "bpm_range": "{{bpm_range}}"}}}, "params": {"mood": {"type": "string", "default": "energetic"}, "bpm_range": {"type": "string", "default": "110-140"}}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "From the user's own library only (music_select); above 120 BPM for energetic formats per TikTok ads guidance."},
    {"id": "music.level_under_voice", "category": "music", "name": "Music level under voice", "detector": {"kind": "always"}, "effect": {"op": "music", "args": {"lufs_rel_voice_db": "{{db}}"}}, "params": {"db": {"type": "number", "default": -18, "min": -24, "max": -10}}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "16 to 20 dB under the voice keeps speech intelligible on phone speakers."},
    {"id": "music.duck_on_speech", "category": "music", "name": "Duck on speech", "detector": {"kind": "always"}, "effect": {"op": "music", "args": {"duck_db": "{{db}}"}}, "params": {"db": {"type": "number", "default": -12, "min": -20, "max": -6}}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "Sidechain compression on the voice; release about 250 ms."},
    {"id": "music.drop_on_hook_end", "category": "music", "name": "Drop at the hook end", "detector": {"kind": "always"}, "effect": {"op": "music", "args": {"cue": "drop", "beat": "context"}}, "params": {}, "applies_to": ["faceless", "ad_ugc", "talking_head"], "source": "house", "default_on": true, "rationale": "The first musical event lands where the hook resolves."},
    {"id": "music.fade_out_end", "category": "music", "name": "Fade out at the end", "detector": {"kind": "always"}, "effect": {"op": "music", "args": {"cue": "cut"}}, "params": {"fade_ms": {"type": "integer", "default": 800, "min": 200, "max": 3000}}, "applies_to": ["talking_head", "ad_ugc", "screen_demo", "podcast_clip", "long_form"], "conflicts_with": ["music.bar_aligned_loop"], "source": "house", "rationale": "Non-looping videos end on a fade, not a hard stop."},
    {"id": "music.bar_aligned_loop", "category": "music", "name": "Bar-aligned loop", "detector": {"kind": "beat", "args": {"downbeats": true}}, "effect": {"op": "music", "args": {"loop": "bar"}}, "params": {}, "applies_to": ["faceless"], "conflicts_with": ["music.fade_out_end"], "source": "house", "rationale": "Looping videos cut the music on a bar boundary so the seam is inaudible (loop_seal)."},
    {"id": "music.silence_under_key_line", "category": "music", "name": "Silence under the key line", "detector": {"kind": "emphasis_word", "args": {"min_score": 2.0}}, "effect": {"op": "music", "args": {"cue": "silence", "beat": "payoff"}}, "params": {}, "applies_to": ["talking_head", "ad_ugc", "faceless"], "source": "house", "rationale": "Dropping the music for the payoff line makes it land harder."}
  ]
}
