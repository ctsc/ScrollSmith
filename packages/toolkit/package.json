{
  "name": "@scrollsmith/toolkit",
  "version": "0.1.0",
  "description": "Local scripts, schemas and validators for the Scrollsmith skills. Runs on the creator's own machine; nothing here calls a model or uploads footage.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "scrollsmith": "./node/cli.mjs"
  },
  "scripts": {
    "test": "node --test tests/",
    "lint": "node --check node/*.mjs && node --check node/lib/*.mjs",
    "typecheck": "node --check node/*.mjs"
  },
  "dependencies": {
    "@remotion/captions": "^4.0.541",
    "ajv": "^8.6.3",
    "ajv-formats": "^3.0.1",
    "fast-json-patch": "^3.1.1"
  }
}
