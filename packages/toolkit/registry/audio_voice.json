{
  "category": "audio_voice",
  "decisions": [
    {"id": "audio_voice.denoise_light", "category": "audio_voice", "name": "Light voice denoise", "detector": {"kind": "always"}, "effect": {"op": "music", "args": {"voice_denoise": "light"}}, "params": {"strength": {"type": "number", "default": 0.4, "min": 0.1, "max": 1.0}}, "applies_to": ["talking_head", "ad_ugc", "podcast_clip", "long_form", "screen_demo"], "source": "house", "default_on": true, "rationale": "RNNoise (arnndn) at low strength removes hiss without the underwater artifact."},
    {"id": "audio_voice.loudness_target", "category": "audio_voice", "name": "Loudness target", "detector": {"kind": "always"}, "effect": {"op": "music", "args": {"target_lufs": "{{lufs}}", "true_peak_db": -1}}, "params": {"lufs": {"type": "number", "default": -14, "min": -18, "max": -12}}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "-14 LUFS integrated and -1 dBTP are common conventions, not verified platform numbers."},
    {"id": "audio_voice.deess", "category": "audio_voice", "name": "De-ess", "detector": {"kind": "always"}, "effect": {"op": "music", "args": {"voice_deess_db": "{{db}}"}}, "params": {"db": {"type": "number", "default": -4, "min": -8, "max": -1}}, "applies_to": ["talking_head", "ad_ugc", "podcast_clip", "long_form"], "source": "house", "rationale": "Phone speakers exaggerate sibilance."},
    {"id": "audio_voice.eq_presence", "category": "audio_voice", "name": "Voice EQ presence preset", "detector": {"kind": "always"}, "effect": {"op": "music", "args": {"voice_eq": "presence"}}, "params": {}, "applies_to": ["talking_head", "ad_ugc", "podcast_clip", "long_form"], "source": "house", "rationale": "High-pass at 80 Hz, small dip at 300 Hz, lift at 3 kHz: clearer on small speakers."},
    {"id": "audio_voice.room_tone_fill", "category": "audio_voice", "name": "Room-tone fill after silence cuts", "detector": {"kind": "silence", "args": {"min_gap_ms": 400}}, "effect": {"op": "crossfade", "args": {"ms": 30, "room_tone": true}}, "params": {}, "applies_to": ["talking_head", "podcast_clip", "long_form"], "requires": ["cut_pacing.silence_remove"], "source": "house", "default_on": true, "rationale": "Hard digital silence between cuts sounds like a glitch; fill with the recording's own noise floor."},
    {"id": "audio_voice.crossfade_30ms", "category": "audio_voice", "name": "30 ms crossfade at every cut", "detector": {"kind": "always"}, "effect": {"op": "crossfade", "args": {"ms": 30}}, "params": {}, "applies_to": ["talking_head", "ad_ugc", "screen_demo", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "Rule F2."},
    {"id": "audio_voice.speaker_level_match", "category": "audio_voice", "name": "Match loudness between speakers", "detector": {"kind": "face_present", "args": {"min_ms": 1000}}, "effect": {"op": "music", "args": {"speaker_match": true}}, "params": {"tolerance_db": {"type": "number", "default": 1.5, "min": 0.5, "max": 3}}, "applies_to": ["podcast_clip", "long_form"], "source": "house", "rationale": "Two mics rarely match; normalize per speaker before the mix."}
  ]
}
