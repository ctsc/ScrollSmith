{
  "category": "transitions",
  "decisions": [
    {"id": "transitions.hard_cut_default", "category": "transitions", "name": "Hard cut by default", "detector": {"kind": "always"}, "effect": {"op": "export_setting", "args": {"default_transition": "cut"}}, "params": {}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "Cuts are invisible; every other transition is a stylistic choice that must earn its place."},
    {"id": "transitions.whip_pan_on_topic_change", "category": "transitions", "name": "Whip pan on topic change", "detector": {"kind": "topic_change"}, "effect": {"op": "layer_add", "args": {"kind": "shape", "slot": "full_bleed", "primitive": "whip_pan", "duration_ms": 250}}, "params": {"duration_ms": {"type": "integer", "default": 250, "min": 150, "max": 400}}, "applies_to": ["faceless", "ad_ugc", "talking_head"], "source": "house", "rationale": "Marks a section change without a title card."},
    {"id": "transitions.zoom_through", "category": "transitions", "name": "Zoom-through between visuals", "detector": {"kind": "scene_cut"}, "effect": {"op": "layer_add", "args": {"kind": "shape", "slot": "full_bleed", "primitive": "zoom_through", "duration_ms": 300}}, "params": {}, "applies_to": ["faceless"], "source": "house", "rationale": "Keeps momentum between 3D scenes."},
    {"id": "transitions.flash_on_reveal", "category": "transitions", "name": "Flash on reveal", "detector": {"kind": "emphasis_word", "args": {"min_score": 2.0}}, "effect": {"op": "layer_add", "args": {"kind": "shape", "slot": "full_bleed", "primitive": "flash", "duration_ms": 120}}, "params": {}, "applies_to": ["faceless", "ad_ugc"], "source": "house", "rationale": "One flash per video, on the payoff."},
    {"id": "transitions.match_cut", "category": "transitions", "name": "Match cut on repeated shapes", "detector": {"kind": "scene_cut"}, "effect": {"op": "layer_add", "args": {"kind": "shape", "slot": "full_bleed", "primitive": "match_cut", "duration_ms": 200}}, "params": {}, "applies_to": ["faceless"], "source": "house", "rationale": "Carry a shape or position across the cut; also the best loop bridge."},
    {"id": "transitions.glitch_rare", "category": "transitions", "name": "Glitch (rare)", "detector": {"kind": "time_range"}, "effect": {"op": "layer_add", "args": {"kind": "shape", "slot": "full_bleed", "primitive": "glitch_cut", "duration_ms": 160}}, "params": {"max_per_video": {"type": "integer", "default": 1, "min": 0, "max": 2}}, "applies_to": ["faceless", "ad_ugc"], "source": "house", "rationale": "Glitch reads as dated when overused; at most once."}
  ]
}
