{
  "category": "broll_overlay",
  "decisions": [
    {"id": "broll_overlay.broll_on_noun_phrase", "category": "broll_overlay", "name": "B-roll on noun phrases", "detector": {"kind": "keyword", "args": {"words": "{{nouns}}"}}, "effect": {"op": "layer_add", "args": {"kind": "video", "slot": "center_visual", "primitive": "crossfade", "duration_ms": 2500}}, "params": {"nouns": {"type": "string[]", "default": []}, "density_per_min": {"type": "integer", "default": 4, "min": 1, "max": 12}, "duration_ms": {"type": "integer", "default": 2500, "min": 1000, "max": 5000}}, "applies_to": ["talking_head", "long_form", "ad_ugc"], "source": "house", "rationale": "Nouns the assistant extracts from the transcript pack become b-roll cues; assets from the user's library or stock_search, registered in the ledger."},
    {"id": "broll_overlay.screenshot_named_product", "category": "broll_overlay", "name": "Screenshot of a named product or site", "detector": {"kind": "keyword", "args": {"words": "{{entities}}"}}, "effect": {"op": "layer_add", "args": {"kind": "image", "slot": "pip", "primitive": "pop_in", "duration_ms": 2000}}, "params": {"entities": {"type": "string[]", "default": []}}, "applies_to": ["talking_head", "screen_demo", "long_form"], "source": "house", "rationale": "Show the thing being named; the user supplies or captures the screenshot."},
    {"id": "broll_overlay.logo_person_meme_on_mention", "category": "broll_overlay", "name": "Logo, person or meme overlay on mention", "detector": {"kind": "keyword", "args": {"words": "{{entities}}"}}, "effect": {"op": "overlay", "args": {"kind": "image", "slot": "pip", "primitive": "pop_in", "duration_ms": 1500}}, "params": {"entities": {"type": "string[]", "default": []}, "max_per_min": {"type": "integer", "default": 6}}, "applies_to": ["talking_head", "podcast_clip", "long_form"], "source": "house", "rationale": "Images of real people carry editorial-use risk and must never imply endorsement; memes carry copyright risk. License flag stored per asset (overlay_image_search)."},
    {"id": "broll_overlay.sticker_on_punchline", "category": "broll_overlay", "name": "Sticker or GIF on the punchline", "detector": {"kind": "sentence_boundary"}, "effect": {"op": "overlay", "args": {"kind": "sticker", "slot": "pip", "primitive": "pop_in", "duration_ms": 1200}}, "params": {"max_per_video": {"type": "integer", "default": 2, "min": 0, "max": 5}}, "applies_to": ["talking_head", "ad_ugc", "faceless"], "source": "house", "rationale": "Prefer user-owned stickers; Giphy and Tenor terms are not verified."},
    {"id": "broll_overlay.pip_source_clip", "category": "broll_overlay", "name": "PiP of a source clip", "detector": {"kind": "time_range"}, "effect": {"op": "layer_add", "args": {"kind": "pip", "slot": "pip", "primitive": "slide", "duration_ms": 4000}}, "params": {}, "applies_to": ["talking_head", "podcast_clip", "long_form"], "source": "house", "rationale": "Reaction and commentary formats; keep inside the safe zone."},
    {"id": "broll_overlay.arrow_highlight_callout", "category": "broll_overlay", "name": "Arrow or highlight callout", "detector": {"kind": "keyword", "args": {"words": ["here", "this", "look", "see"]}}, "effect": {"op": "overlay", "args": {"kind": "callout", "slot": "caption", "primitive": "draw_on", "duration_ms": 1200}}, "params": {}, "applies_to": ["screen_demo", "talking_head"], "source": "house", "rationale": "Deictic words usually point at something on screen."},
    {"id": "broll_overlay.never_cover_face_emotional", "category": "broll_overlay", "name": "No b-roll over emotional moments", "detector": {"kind": "emphasis_word", "args": {"min_score": 2.5}}, "effect": {"op": "export_setting", "args": {"broll_blackout": true}}, "params": {}, "applies_to": ["talking_head", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "The face carries the emotional peak; keep it on screen."}
  ]
}
