{
  "category": "sfx",
  "decisions": [
    {"id": "sfx.whoosh_on_transition", "category": "sfx", "name": "Whoosh on transitions", "detector": {"kind": "scene_cut"}, "effect": {"op": "sfx", "args": {"role": "whoosh", "sync": "absolute"}}, "params": {"gain_db": {"type": "number", "default": -9, "min": -20, "max": -3}, "min_spacing_ms": {"type": "integer", "default": 300}}, "applies_to": ["faceless", "ad_ugc", "talking_head", "screen_demo"], "source": "house", "default_on": true, "rationale": "From the user's SFX library; asset chosen by sfx_place."},
    {"id": "sfx.pop_on_text_in", "category": "sfx", "name": "Pop on text-in", "detector": {"kind": "keyword", "args": {"words": []}}, "effect": {"op": "sfx", "args": {"role": "pop", "sync": "absolute"}}, "params": {"gain_db": {"type": "number", "default": -9}, "min_spacing_ms": {"type": "integer", "default": 300}}, "applies_to": ["faceless", "ad_ugc", "screen_demo"], "source": "house", "default_on": true, "rationale": "Every on-screen text entry gets a short pop; never over a key word."},
    {"id": "sfx.riser_into_reveal", "category": "sfx", "name": "Riser into the reveal", "detector": {"kind": "sentence_boundary"}, "effect": {"op": "sfx", "args": {"role": "riser", "sync": "beat", "before_ms": 1200}}, "params": {"gain_db": {"type": "number", "default": -12}}, "applies_to": ["faceless", "ad_ugc"], "source": "house", "rationale": "A 1 to 2 s riser before the payoff range."},
    {"id": "sfx.click_on_counter", "category": "sfx", "name": "Click on counter ticks", "detector": {"kind": "beat"}, "effect": {"op": "sfx", "args": {"role": "click", "sync": "beat"}}, "params": {"gain_db": {"type": "number", "default": -14}, "min_spacing_ms": {"type": "integer", "default": 120}}, "applies_to": ["faceless"], "source": "house", "rationale": "Number rolls read as physical when each step clicks."},
    {"id": "sfx.impact_on_zoom_punch", "category": "sfx", "name": "Impact on zoom punch", "detector": {"kind": "emphasis_word", "args": {"min_score": 1.5}}, "effect": {"op": "sfx", "args": {"role": "impact", "sync": "word"}}, "params": {"gain_db": {"type": "number", "default": -10}, "min_spacing_ms": {"type": "integer", "default": 2000}}, "applies_to": ["talking_head", "ad_ugc"], "requires": ["zoom_framing.punch_on_emphasis_word"], "source": "house", "rationale": "Pair the loudest punch-ins with a soft impact; most punch-ins stay silent."},
    {"id": "sfx.min_spacing", "category": "sfx", "name": "Minimum SFX spacing", "detector": {"kind": "always"}, "effect": {"op": "sfx", "args": {"policy": "min_spacing"}}, "params": {"min_spacing_ms": {"type": "integer", "default": 300, "min": 150, "max": 1000}}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "Stacked SFX turn into noise."}
  ]
}
