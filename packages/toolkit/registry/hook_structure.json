{
  "category": "hook_structure",
  "decisions": [
    {"id": "hook_structure.cold_open_strongest_line", "category": "hook_structure", "name": "Cold open on the strongest line", "detector": {"kind": "always"}, "effect": {"op": "reorder", "args": {"beat": "hook"}}, "params": {}, "applies_to": ["talking_head", "ad_ugc", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "Rule F5; the assistant picks the line and verifies it is self-contained and truthful."},
    {"id": "hook_structure.text_hook_frame0", "category": "hook_structure", "name": "Text hook over frame 0", "detector": {"kind": "time_range", "args": {"start_ms": 0, "end_ms": 2500}}, "effect": {"op": "layer_add", "args": {"kind": "text", "slot": "top_title", "primitive": "word_slam", "duration_ms": 2500}}, "params": {"max_words": {"type": "integer", "default": 7, "min": 3, "max": 10}}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip"], "source": "house", "default_on": true, "rationale": "Most feeds start muted; the hook must read without sound."},
    {"id": "hook_structure.pattern_interrupt_visual", "category": "hook_structure", "name": "Pattern-interrupt visual", "detector": {"kind": "time_range", "args": {"start_ms": 0, "end_ms": 800}}, "effect": {"op": "zoom", "args": {"scale": 1.2, "ms": 400, "easing": "spring_snappy"}}, "params": {}, "applies_to": ["faceless", "ad_ugc", "talking_head"], "source": "house", "rationale": "A motion or scale event in the first 0.8 s."},
    {"id": "hook_structure.tease_then_context", "category": "hook_structure", "name": "Tease then context reorder", "detector": {"kind": "always"}, "effect": {"op": "reorder", "args": {"beat": "payoff"}}, "params": {}, "applies_to": ["talking_head", "long_form", "podcast_clip"], "conflicts_with": ["hook_structure.cold_open_strongest_line"], "source": "house", "rationale": "Show a glimpse of the payoff, then back up (in media res)."},
    {"id": "hook_structure.proposition_by_3s", "category": "hook_structure", "name": "Proposition by 3 s check", "detector": {"kind": "time_range", "args": {"start_ms": 0, "end_ms": 3000}}, "effect": {"op": "export_setting", "args": {"hook_check_ms": 3000}}, "params": {}, "applies_to": ["talking_head", "faceless", "ad_ugc", "screen_demo", "podcast_clip", "long_form"], "source": "house", "default_on": true, "rationale": "TikTok creative best practices (ads context): proposition in the first 3 s. Enforced by rule T2."},
    {"id": "hook_structure.open_loop_label", "category": "hook_structure", "name": "Open loop label on the hook", "detector": {"kind": "time_range", "args": {"start_ms": 0, "end_ms": 3000}}, "effect": {"op": "layer_add", "args": {"kind": "text", "slot": "hud_top", "primitive": "typewriter", "duration_ms": 2000}}, "params": {}, "applies_to": ["faceless", "talking_head"], "source": "house", "rationale": "Small label naming what the viewer will get at the end (wait for day 30)."}
  ]
}
